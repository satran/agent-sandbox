#!/usr/bin/env bash
#
# sb - run a coding agent inside a per-project docker container.
#
#   sb <agent> [path] [options] [-- agent-args...]
#   sb list
#
# Each (agent, project) pair gets its own long-lived container. The project is
# mounted at the same path relative to $HOME inside the container, and you are
# attached to a tmux session running the agent. Detach with C-b d; running
# sb again re-attaches.
#
# Agents are defined by containers/<agent>/{Dockerfile,sandbox.conf}.
#
# The agent runs with permission checks off, so the container is the boundary:
# it has no capabilities, no sudo, no route to the host or LAN, and cannot
# gain privileges. See "Isolation" in README.md.

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONTAINERS="$ROOT/containers"
CUSER=agent
CHOME="/home/$CUSER"
CPATH="$CHOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Isolated bridge, so sandboxes cannot see each other or use the host resolver.
NETWORK=sandbox
SB_DNS="${SB_DNS:-1.1.1.1 8.8.8.8}"
SB_PIDS="${SB_PIDS:-2048}"
SB_MEMORY="${SB_MEMORY:-}"
SB_CPUS="${SB_CPUS:-}"
SB_BLOCKED_NETS="${SB_BLOCKED_NETS:-}"
SB_FIREWALL="${SB_FIREWALL:-}"

usage() {
	cat <<EOF
usage: sb <agent> [path] [options] [-- agent-args...]
       sb list

options:
  --rebuild    rebuild the agent image (implies --recreate)
  --recreate   remove this project's container and start a fresh one
  --args ARGS  arguments for the agent, split like a shell command line
               (repeatable), e.g. --args '--plugin-dir src/plugin'
  --mount DIR[:ro]
               also mount DIR, read-write or :ro (repeatable; applied when
               the container is created, so change with --recreate)
  --stop       stop this project's container
  -h, --help   show this help

Everything after -- is also passed to the agent, unchanged.

environment (applied when the container is created):
  SB_MEMORY, SB_CPUS, SB_PIDS   resource limits (default: pids $SB_PIDS)
  SB_DNS                        resolvers (default: $SB_DNS)
  SB_BLOCKED_NETS               networks to deny egress to
  SB_FIREWALL=off               disable the egress firewall (debugging)

agents: $(ls "$CONTAINERS"/*/sandbox.conf 2>/dev/null | xargs -n1 dirname | xargs -n1 basename | tr '\n' ' ')
EOF
}

die() { echo "sb: $*" >&2; exit 1; }

if [[ $# -eq 0 ]]; then usage; exit 1; fi

case "$1" in
	-h|--help) usage; exit 0 ;;
	list)
		docker ps -a --filter label=sandbox.agent \
			--format 'table {{.Names}}\t{{.Status}}\t{{.Label "sandbox.project"}}'
		exit 0 ;;
esac

AGENT="$1"; shift
AGENT_DIR="$CONTAINERS/$AGENT"
[[ -f "$AGENT_DIR/sandbox.conf" ]] || die "unknown agent '$AGENT' (no $AGENT_DIR/sandbox.conf)"

PROJECT="$PWD"
REBUILD=0 RECREATE=0 STOP=0
# --args strings are joined and parsed by the shell in the container, so
# quoting works as on a command line; args after "--" are passed as-is.
ARGS_STR=""
AGENT_ARGS=()
MOUNT_SPECS=()
HAVE_PATH=0
while [[ $# -gt 0 ]]; do
	case "$1" in
		--rebuild) REBUILD=1 RECREATE=1 ;;
		--recreate) RECREATE=1 ;;
		--stop) STOP=1 ;;
		--args)
			[[ $# -ge 2 ]] || die "--args needs a value"
			shift; ARGS_STR+=" $1" ;;
		--args=*) ARGS_STR+=" ${1#--args=}" ;;
		--mount)
			[[ $# -ge 2 ]] || die "--mount needs a directory"
			shift; MOUNT_SPECS+=("$1") ;;
		--mount=*) MOUNT_SPECS+=("${1#--mount=}") ;;
		-h|--help) usage; exit 0 ;;
		--) shift; AGENT_ARGS=("$@"); break ;;
		-*) die "unknown option $1 (pass agent options with --args)" ;;
		*)
			[[ $HAVE_PATH -eq 0 ]] || die "unexpected argument $1 (pass agent arguments with --args)"
			PROJECT="$1" HAVE_PATH=1 ;;
	esac
	shift
done

# Per-agent settings. CONFIG_MOUNTS are "host:container" with host relative to
# the repo root; AGENT_CMD is what runs in the first tmux window.
CONFIG_MOUNTS=()
AGENT_ENV=()
AGENT_CMD=()
# shellcheck source=/dev/null
source "$AGENT_DIR/sandbox.conf"
[[ ${#AGENT_CMD[@]} -gt 0 ]] || die "$AGENT_DIR/sandbox.conf does not set AGENT_CMD"

HOST_HOME="$(cd "$HOME" && pwd -P)"

# Never mount /, $HOME or a parent of it, or home/, which holds every
# agent's credentials.
check_mountable() {
	[[ "$1" != / && "$1" != "$HOST_HOME" && "$HOST_HOME" != "$1"/* ]] ||
		die "refusing to mount $1"
	[[ "$1" != "$ROOT/home" && "$1" != "$ROOT/home/"* ]] ||
		die "refusing to mount $1, it holds agent credentials"
}

# Mirror the path relative to $HOME so agent session history stays stable.
container_path() {
	if [[ "$1" == "$HOST_HOME"/* ]]; then
		printf '%s\n' "$CHOME/${1#"$HOST_HOME"/}"
	else
		printf '%s\n' "$CHOME/ext$1"
	fi
}

[[ -d "$PROJECT" ]] || die "no such directory: $PROJECT"
PROJECT="$(cd "$PROJECT" && pwd -P)"
check_mountable "$PROJECT"
CPROJECT="$(container_path "$PROJECT")"

# Extra mounts, resolved to "path" or "path:ro".
MOUNTS=()
for m in ${MOUNT_SPECS[@]+"${MOUNT_SPECS[@]}"}; do
	ro=""
	[[ "$m" == *:ro ]] && { m="${m%:ro}"; ro=":ro"; }
	[[ -d "$m" ]] || die "no such directory: $m"
	m="$(cd "$m" && pwd -P)"
	check_mountable "$m"
	[[ "$m" != *[:,$'\n']* ]] || die "cannot mount $m: ':', ',' or newline in the path"
	[[ "$m" != "$PROJECT" ]] || die "$m is the project, it is already mounted"
	for o in ${MOUNTS[@]+"${MOUNTS[@]}"}; do
		[[ "${o%:ro}" != "$m" ]] || die "$m is given twice"
	done
	MOUNTS+=("$m$ro")
done
MOUNTS_LABEL="$(printf '%s\n' ${MOUNTS[@]+"${MOUNTS[@]}"})"

IMAGE="sandbox-$AGENT"
SLUG="$(echo "${PROJECT#"$HOST_HOME"/}" | tr -c 'a-zA-Z0-9_.\n' '-' | sed 's/^-*//')"
HASH="$(printf '%s' "$PROJECT" | shasum | cut -c1-6)"
NAME="sandbox-$AGENT-$SLUG-$HASH"

container_state() {
	docker container inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null || true
}

ensure_network() {
	local icc
	if icc="$(docker network inspect -f \
		'{{index .Options "com.docker.network.bridge.enable_icc"}}' "$NETWORK" 2>/dev/null)"; then
		[[ "$icc" == false ]] ||
			die "docker network $NETWORK allows inter-container traffic; remove it"
		return
	fi
	echo "sb: creating docker network $NETWORK" >&2
	docker network create -o com.docker.network.bridge.enable_icc=false \
		"$NETWORK" >/dev/null
}

# Host-side state: snapshots and generated files. Under home/, so it is
# gitignored, never a project, and hidden from a sandbox working on this repo.
STATE_DIR="$ROOT/home/.sb"

# Files in the project that the host runs as code: git hooks and config
# (core.fsmonitor, core.hooksPath, filters), direnv and VS Code tasks. One
# "hash<TAB>exec<TAB>link<TAB>path" line each, so any change shows up.
guard_snapshot() {
	local f g d dirs=("$PROJECT")
	# Writable extra mounts are as exposed as the project.
	for d in ${MOUNTS[@]+"${MOUNTS[@]}"}; do
		[[ "$d" == *:ro ]] || dirs+=("$d")
	done
	for d in "${dirs[@]}"; do
		find "$d" -maxdepth 4 \( -name node_modules -o -name .venv \) -prune -o \
			-type d -name .git -prune -print -o \
			\( -type f -o -type l \) \( -name .envrc -o -path '*/.vscode/*.json' \) -print \
			2>/dev/null || true
	done |
		while IFS= read -r g; do
			if [[ -d "$g" && ! -L "$g" ]]; then
				find "$g/config" "$g/hooks" \( -type f -o -type l \) 2>/dev/null
			else
				printf '%s\n' "$g"
			fi
		done | LC_ALL=C sort -u | while IFS= read -r f; do
			printf '%s\t%s\t%s\t%s\n' \
				"$(shasum <"$f" 2>/dev/null | cut -c1-40 || true)" \
				"$([[ -x "$f" ]] && echo x || echo -)" \
				"$(readlink "$f" || echo -)" "${f#"$PROJECT"/}"
		done
}

# Warn about changes since the last check, then take a new baseline. Warn
# only: the agent may have had a good reason, but you should know.
guard_check() {
	local snap="$STATE_DIR/$NAME.guard" now changed
	now="$(guard_snapshot || true)"
	if [[ -f "$snap" ]]; then
		changed="$(diff "$snap" - <<<"$now" | sed -n 's/^[<>] //p' | cut -f4 | sed '/^$/d' | sort -u || true)"
		if [[ -n "$changed" ]]; then
			{
				echo "sb: WARNING: files that run code on the host changed since the last check:"
				sed 's/^/sb:   /' <<<"$changed"
				echo "sb: review them before you run git or open the project in an editor."
			} >&2
		fi
	fi
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$now" >"$snap"
}

# Only identity and harmless preferences reach the sandbox; the host config
# may hold tokens (url.*.insteadOf, http.*.extraheader, credential.*).
GIT_SAFE_KEYS='^(user\.(name|email)|init\.defaultbranch|alias\..*|color\..*|core\.(autocrlf|eol|whitespace|quotepath)|pull\.(rebase|ff)|push\.(default|autosetupremote|followtags)|fetch\.(prune|prunetags)|merge\.(conflictstyle|ff)|rebase\.(autosquash|autostash|updaterefs)|rerere\.enabled|diff\.(algorithm|colormoved|renames)|(branch|tag)\.sort|column\.ui|help\.autocorrect|commit\.verbose)$'

write_gitconfig() {
	local out="$1" entry key val
	: >"$out"
	command -v git >/dev/null || return 0
	{ git config --global --includes --null --get-regexp "$GIT_SAFE_KEYS" 2>/dev/null || true; } |
		while IFS= read -r -d '' entry; do
			key="${entry%%$'\n'*}" val=true
			[[ "$entry" == *$'\n'* ]] && val="${entry#*$'\n'}"
			git config -f "$out" --add "$key" "$val" || true
		done
}

# Docker Desktop runs containers in a VM that sees every directory listed
# under File sharing; by default that is all of /Users. Code that escapes a
# container lands in that VM, so it should see no more than sb mounts.
check_file_sharing() {
	local f d
	[[ "$(uname -s)" == Darwin ]] || return 0
	for f in "$HOME/Library/Group Containers/group.com.docker/settings-store.json" \
		"$HOME/Library/Group Containers/group.com.docker/settings.json"; do
		[[ -f "$f" ]] || continue
		tr -d '\n' <"$f" | grep -oiE '"filesharingDirectories" *: *\[[^]]*\]' |
			sed -E 's/^[^[]*\[//; s/\]$//' | tr ',' '\n' |
			sed -E 's/^[[:space:]]*"//; s/"[[:space:]]*$//' |
			while IFS= read -r d; do
				[[ -n "$d" ]] || continue
				d="${d%/}"
				if [[ "$HOST_HOME" == "$d" || "$HOST_HOME" == "$d"/* || -z "$d" ]]; then
					echo "sb: Docker Desktop shares ${d:-/} with its VM, which includes your home directory." >&2
					echo "sb: limit Settings > Resources > File sharing to your projects and $ROOT." >&2
				fi
			done || true
		return 0
	done
}

if [[ $STOP -eq 1 ]]; then
	[[ -n "$(container_state)" ]] && docker stop "$NAME" >/dev/null
	exit 0
fi

if [[ $RECREATE -eq 1 && -n "$(container_state)" ]]; then
	echo "sb: removing $NAME" >&2
	docker rm -f "$NAME" >/dev/null
fi

# Containers created before the hardening keep their old, permissive settings.
if [[ -n "$(container_state)" ]] &&
	! docker container inspect -f '{{.HostConfig.SecurityOpt}}' "$NAME" 2>/dev/null |
		grep -q no-new-privileges; then
	die "$NAME predates the sandbox hardening, run with --recreate"
fi

# Mounts are fixed when the container is created. Without --mount, keep
# what it has, so the guard still covers those directories.
if [[ -n "$(container_state)" ]]; then
	have="$(docker container inspect -f '{{index .Config.Labels "sandbox.mounts"}}' "$NAME")"
	if [[ ${#MOUNTS[@]} -eq 0 ]]; then
		MOUNTS=()
		while IFS= read -r m; do
			[[ -z "$m" ]] || MOUNTS+=("$m")
		done <<<"$have"
	elif [[ "$have" != "$MOUNTS_LABEL" ]]; then
		die "$NAME was created with other mounts, run with --recreate"
	fi
fi

if [[ $REBUILD -eq 1 ]] || ! docker image inspect sandbox-base >/dev/null 2>&1; then
	echo "sb: building sandbox-base" >&2
	docker build -t sandbox-base "$CONTAINERS/base"
	REBUILD=1
fi
if [[ $REBUILD -eq 1 ]] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
	echo "sb: building $IMAGE" >&2
	docker build -t "$IMAGE" "$AGENT_DIR"
fi

case "$(container_state)" in
	running) ;;
	"")
		ensure_network
		check_file_sharing
		# The main process is root only so sandbox-init can install the
		# firewall; the agent is exec'd as $CUSER and never sees those rights.
		args=(
			-d --name "$NAME" --hostname "$AGENT"
			--label sandbox.agent="$AGENT" --label sandbox.project="$PROJECT"
			--label sandbox.mounts="$MOUNTS_LABEL"
			--user 0:0
			--security-opt no-new-privileges
			--cap-drop ALL --cap-add NET_ADMIN
			--network "$NETWORK"
			--sysctl net.ipv6.conf.all.disable_ipv6=1
			--sysctl net.ipv6.conf.default.disable_ipv6=1
			--pids-limit "$SB_PIDS"
			--ulimit core=0 --ulimit nofile=8192:16384
			-e PATH="$CPATH" -e COLORTERM=truecolor
			-e HOME="$CHOME" -e USER="$CUSER"
			-e SANDBOX_HOST="$(hostname -s)" -e SANDBOX_PROJECT="${PROJECT/#"$HOST_HOME"/\~}"
			-v "$PROJECT:$CPROJECT" -w "$CPROJECT"
			-v "$CONTAINERS/tmux.conf:$CHOME/.tmux.conf:ro"
		)
		for d in $SB_DNS; do
			args+=(--dns "$d")
		done
		[[ -n "$SB_MEMORY" ]] && args+=(--memory "$SB_MEMORY")
		[[ -n "$SB_CPUS" ]] && args+=(--cpus "$SB_CPUS")
		[[ -n "$SB_BLOCKED_NETS" ]] && args+=(-e SANDBOX_BLOCKED_NETS="$SB_BLOCKED_NETS")
		[[ -n "$SB_FIREWALL" ]] && args+=(-e SANDBOX_FIREWALL="$SB_FIREWALL")
		for m in ${CONFIG_MOUNTS[@]+"${CONFIG_MOUNTS[@]}"}; do
			host="$ROOT/${m%%:*}"
			mkdir -p "$host"
			args+=(-v "$host:${m#*:}")
		done
		for e in ${AGENT_ENV[@]+"${AGENT_ENV[@]}"}; do
			args+=(-e "$e")
		done
		for m in ${MOUNTS[@]+"${MOUNTS[@]}"}; do
			ro=""
			[[ "$m" == *:ro ]] && { m="${m%:ro}"; ro=":ro"; }
			args+=(-v "$m:$(container_path "$m")$ro")
		done
		# A mount that contains this repo would otherwise expose every
		# agent's stored credentials, so shadow home/ with an empty
		# read-only tmpfs. Nested mounts see it once, at its mirrored path.
		for m in "$PROJECT" ${MOUNTS[@]+"${MOUNTS[@]}"}; do
			m="${m%:ro}"
			if [[ "$ROOT" == "$m" || "$ROOT" == "$m"/* ]]; then
				args+=(--tmpfs "$(container_path "$ROOT")/home:ro,size=1m")
				break
			fi
		done
		mkdir -p "$STATE_DIR"
		write_gitconfig "$STATE_DIR/$NAME.gitconfig"
		[[ -s "$STATE_DIR/$NAME.gitconfig" ]] &&
			args+=(-v "$STATE_DIR/$NAME.gitconfig:$CHOME/.gitconfig:ro")
		# Absolute: a bare name is resolved through PATH, which starts in
		# the agent-writable ~/.local/bin, on every start.
		docker run "${args[@]}" "$IMAGE" /usr/local/bin/sandbox-init >/dev/null
		;;
	*) docker start "$NAME" >/dev/null ;;
esac

# Never attach before sandbox-init reports the firewall is up; it exits
# instead of signalling if the rules could not be installed.
wait_ready() {
	local i
	for ((i = 0; i < 100; i++)); do
		[[ "$(container_state)" == running ]] || return 1
		# The marker holds PID 1's start time, so a stale one never matches.
		docker exec --user "$CUSER" "$NAME" sh -c \
			'[ "$(cat /run/sandbox-ready)" = "$(awk "{print \$22}" /proc/1/stat)" ]' \
			2>/dev/null && return 0
		sleep 0.1
	done
	return 1
}

if ! wait_ready; then
	docker logs --tail 20 "$NAME" >&2 || true
	die "sandbox $NAME did not come up"
fi

# The agent keeps running while detached, so check on the way in and out.
guard_check

# Build the agent command line; when the agent exits, the window drops to bash.
cmd="$(printf '%q ' "${AGENT_CMD[@]}")$ARGS_STR"
[[ ${#AGENT_ARGS[@]} -eq 0 ]] || cmd+=" $(printf '%q ' "${AGENT_ARGS[@]}")"
rc=0
docker exec -it --user "$CUSER" "$NAME" bash -c '
	set -e
	if ! command -v tmux >/dev/null; then
		echo "sb: tmux is not installed in this image" >&2; exit 1
	fi
	if ! tmux has-session -t sandbox 2>/dev/null; then
		tmux new-session -d -s sandbox -n "$1" -c "$2" "$3; exec bash"
		tmux new-window -d -t sandbox -n shell -c "$2"
	elif [ -n "$4" ]; then
		echo "sb: session already running, ignoring agent args" >&2
	fi
	exec tmux attach -t sandbox
' _ "$AGENT" "$CPROJECT" "$cmd" "$ARGS_STR${AGENT_ARGS[*]-}" || rc=$?
guard_check
exit "$rc"
